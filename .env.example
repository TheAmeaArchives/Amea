# Root Next.js env
# Copy these values into: .env

INTERNAL_API_BASE_URL=http://127.0.0.1:4000
INTERNAL_API_TOKEN=anameathing
NEXT_PUBLIC_AUTH_URL=http://127.0.0.1:3000/api/auth

# Shared media config used by both Next.js and the backend
AWS_S3_PUBLIC_BASE_URL=https://your-public-media-bucket.s3.us-east-1.amazonaws.com

# Backend env
# Copy these values into: backend/.env

NODE_ENV=development
HOST=0.0.0.0
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/amea

# Required for Better Auth OTP
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret
BETTER_AUTH_URL=http://127.0.0.1:3000/api/auth
RESEND_API_KEY=re_f79cDWMq_Q7wVQCFjmunUrCniq3J9ULX7
RESEND_FROM_EMAIL=amea@auth.josiasw.dev

# Comma-separated origins allowed to call auth endpoints
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_OTP_EXPIRES_IN_SECONDS=300
AUTH_OTP_ALLOWED_ATTEMPTS=3
AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_OTP_RATE_LIMIT_MAX=3
AUTH_REQUEST_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_REQUEST_RATE_LIMIT_MAX=5
AUTH_DISABLE_SIGNUP=false

# S3 image storage
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-public-media-bucket
AWS_S3_REGION=us-east-1
AWS_S3_ENDPOINT=
AWS_S3_KEY_PREFIX=uploads
AWS_S3_FORCE_PATH_STYLE=false

# Local video hosting
UPLOAD_DIRECTORY=uploads
UPLOAD_PUBLIC_BASE_URL=http://127.0.0.1:4000/uploads
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_VIDEO_MAX_BYTES=104857600
